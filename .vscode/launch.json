{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MIRAI: Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "browserLaunchLocation": "ui",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "pathMapping": { "/_nuxt": "${workspaceFolder}/app", "/_nuxt/@fs": "/" },
      "preLaunchTask": "Nuxt: dev"
    },
    {
      "name": "MIRAI: Edge",
      "type": "pwa-msedge",
      "request": "launch",
      "browserLaunchLocation": "ui",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "pathMapping": { "/_nuxt": "${workspaceFolder}/app", "/_nuxt/@fs": "/" },
      "preLaunchTask": "Nuxt: dev"
    },
    {
      "name": "Nuxt: server (SSR)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/nuxt/bin/nuxt.mjs",
      "args": ["dev", "--no-fork", "--host", "0.0.0.0", "--port", "3000"],
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--enable-source-maps"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    }
  ]
}
