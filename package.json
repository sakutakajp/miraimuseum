{
  "name": "mirai-museum",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "postinstall": "nuxt prepare",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "preview-storybook": "vite preview --outDir storybook-static --host 0.0.0.0 --port 6006 --strictPort",
    "test:storybook": "npm run build-storybook && playwright test --config playwright.storybook.config.ts",
    "generate": "nuxt generate",
    "test:browser": "playwright test",
    "test:browser:static": "playwright test --config playwright.offline.config.ts",
    "test:runtime": "playwright test --config playwright.runtime.config.ts"
  },
  "dependencies": {
    "nuxt": "4.5.2",
    "vue": "3.5.43",
    "@babylonjs/core": "^8.56.0",
    "@babylonjs/loaders": "^8.56.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@storybook-vue/nuxt": "^10.0.0",
    "@storybook/addon-docs": "^10.6.1",
    "storybook": "^10.6.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "vue-tsc": "3.2.6"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  }
}
